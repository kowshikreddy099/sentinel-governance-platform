# SQLite works out of the box. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./sentinel.db
# DATABASE_URL=postgresql+psycopg://sentinel:change-me@localhost:5432/sentinel
ALLOWED_ORIGINS=http://localhost:5173
REQUIRE_AUTH=false

# Optional LangChain/OpenAI policy explanation service.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OpenTelemetry Collector endpoint, for example http://otel-collector:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=
